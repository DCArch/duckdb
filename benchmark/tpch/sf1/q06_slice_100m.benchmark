# name: benchmark/tpch/sf1/q06_slice_100m.benchmark
# description: TPC-H-derived q06 slice (first 100m lineitem rows via rowid pushdown) — DCSim work-based-ROI calibration
# group: [sf1]

include benchmark/tpch/tpch_load.benchmark.in

name Q06_SLICE_100m
group tpch
subgroup sf${sf}

run
SELECT sum(l_extendedprice * l_discount) AS revenue
FROM lineitem
WHERE rowid < 100000000
  AND l_shipdate >= DATE '1994-01-01' AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07 AND l_quantity < 24;
